{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "orders.list",
        "responses": {
          "200": {
            "description": "The orders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": [
          "id",
          "note",
          "customer",
          "quantity",
          "total",
          "attachment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "customer": {
            "$ref": "#/components/schemas/Customer",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "exclusiveMinimum": true
          },
          "total": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "attachment": {
            "type": "file"
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
