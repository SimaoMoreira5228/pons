      "errors": [
        {"status": 404, "name": ["not", "found", "error"], "content": "json", "body": {"ref": "fixture::Problem"}}
      ],
      "auth": {"alternatives": [["session"]], "optional": false},
      "semantics": {"safe": true, "idempotent": true}
    },
    {
      "id": [["users"], ["create"]],
      "method": "POST",
      "path": [{"lit": "users"}],
      "body": {"ty": {"ref": "fixture::CreateUser"}, "content": "json", "required": true},
      "responses": [{"status": 201, "content": "json", "body": {"ref": "fixture::User"}}],
      "auth": {"alternatives": [["session"]], "optional": false},
      "semantics": {"safe": false, "idempotent": false}
    },
    {
      "id": [["users"], ["list"]],
      "method": "GET",
      "path": [{"lit": "users"}],
      "responses": [{"status": 200, "content": "json", "body": {"kind": "array", "item": {"ref": "fixture::User"}}}],
      "auth": {"alternatives": [["tenant"]], "optional": false},
      "semantics": {"safe": true, "idempotent": true}
    }
  ]
